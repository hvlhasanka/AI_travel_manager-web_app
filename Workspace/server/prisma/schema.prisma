generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  productId      String   @id
  productName    String
  destination    String
  category       String
  description    String
  imageUrl       String?
  price          Float
  inventoryCount Int      @default(0)
  validFrom      DateTime
  validUntil     DateTime
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([validUntil])
  @@index([category])
  @@index([price])
}
